{
  "name": "accessible-design-studio-native",
  "version": "1.1.0",
  "private": true,
  "author": "Jason Stys",
  "description": "An offline component blueprint authoring application using the real accessible design system",
  "main": "main.cjs",
  "scripts": {
    "test": "node --test tests/*.test.cjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "electron": "44.11.0",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "com.jasonstys.accessibledesignstudio",
    "productName": "Accessible Design Studio",
    "directories": {
      "output": "../release/native"
    },
    "files": [
      "*.cjs",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "executableName": "AccessibleDesignStudio",
      "signExecutable": false
    },
    "asar": true
  }
}
