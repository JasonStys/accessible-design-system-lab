{
  "name": "accessible-design-system-lab",
  "version": "1.0.0",
  "description": "Native-first React components, design tokens, accessibility evidence, and framework-independent examples.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist/package",
    "dist/types",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/package/accessible-design-system.js"
    },
    "./styles.css": "./dist/package/accessible-design-system.css"
  },
  "engines": {
    "node": ">=22.12 <25"
  },
  "scripts": {
    "build": "npm run clean && npm run build:types && npm run build:package && npm run build:site",
    "build:package": "vite build --config vite.lib.config.ts",
    "build:site": "vite build",
    "build:storybook": "storybook build --quiet",
    "build:types": "tsc -p tsconfig.build.json",
    "bundle:check": "node scripts/check-bundle.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "package:smoke": "node scripts/package-smoke.mjs",
    "repository:check": "node scripts/validate-repository.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "symbols": "node scripts/generate-code-index.mjs",
    "symbols:check": "node scripts/generate-code-index.mjs --check",
    "test": "vitest run --coverage",
    "test:e2e": "node scripts/run-browser-tests.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build && npm run bundle:check && npm run package:smoke && npm run build:storybook && npm run symbols:check && npm run repository:check"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
